# ==============================================================================
# Model Providers Configuration & API Keys (Template / Example)
# Copy this file to .env and fill in your actual credentials.
# NEVER commit the real .env file with actual keys to version control.
# ==============================================================================

# Local LM Studio (OpenAI-compatible server running on localhost)
# Default port for LM Studio is 1234
LM_STUDIO_URL=http://127.0.0.1:1234/v1
LOCAL_API_KEY=lm-studio

# Google Gemini (OpenAI-compatible endpoint)
# Endpoint: https://generativelanguage.googleapis.com/v1beta/openai/
# Generate your key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Groq Cloud (Ultra high-speed LLaMA inference)
# Endpoint: https://api.groq.com/openai/v1
# Generate your key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Server Port (optional, defaults to 3000)
PORT=3000
