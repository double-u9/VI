# ==============================================================================
# Security & Git Leak Protection (DO NOT COMMIT SECRETS)
# ==============================================================================

# Environment variable files containing API keys
.env
.env.*
!.env.example
*.env

# Dependency directories
node_modules/
package-lock.json.bak

# Python caches (if running Python utilities or wrappers)
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/

# System and editor files
.DS_Store
Thumbs.db
*.log
npm-debug.log*
yarn-debug.log*
.idea/
.vscode/

# Temporary test & calibration files
test_*.html
analyze_*.html
calibrate_*.html
.session_cache.json
.session_cache.json.tmp
backend/.session_cache.json
backend/.session_cache.json.tmp

# Embedded SQLite database & WAL files
*.db
*.db-journal
*.db-wal
*.db-shm
backend/*.db*
